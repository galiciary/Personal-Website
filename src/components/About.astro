---
import { site, socials, nav } from '../data/site';
import Icon from './Icon.astro';
import Backdrop from './Backdrop.astro';
---

<section class="section contact reveal" id="about">
  <!-- decoration sits outside .wrap so it can use the full section width -->
  <Backdrop />

  <div class="wrap cols">
    <div class="col">
      <h2>Contact me</h2>
      <ul class="links">
        <li>
          <span class="label">Email:</span>
          <a href={`mailto:${site.email}`} target="_blank" rel="noopener">{site.email}</a>
        </li>
        {
          socials.map((s) => (
            <li>
              <span class="label">{s.label}:</span>
              <a href={s.href} target="_blank" rel="me noopener">
                {s.href.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '')}
              </a>
            </li>
          ))
        }
        <li>
          <span class="label">Discord:</span>
          <span class="value">{site.discord}</span>
        </li>
      </ul>

      <ul class="social-icons">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="me noopener" aria-label={s.label} title={s.label}>
                <Icon name={s.icon} />
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={`mailto:${site.email}`}
            target="_blank"
            rel="noopener"
            aria-label="Email"
            title={site.email}
          >
            <Icon name="mail" />
          </a>
        </li>
      </ul>
    </div>

    <div class="col">
      <h2>Site map</h2>
      <ul class="map">
        <li><a href="#top">Home</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li>
          <a href={site.resume} target="_blank" rel="noopener">Résumé</a>
        </li>
      </ul>

      <p class="where">{site.location}</p>
    </div>
  </div>
</section>

<style>
  /* shorter than the other bands, this one is a footer block rather than a section */
  .contact {
    padding-block: clamp(3rem, 8vh, 4.5rem);
  }

  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 3rem;
  }

  h2 {
    font-size: 1.35rem;
    letter-spacing: -0.015em;
    margin-bottom: 0.9rem;
  }

  .links,
  .map {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links li,
  .map li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.18rem 0;
    font-size: 0.9375rem;
  }

  .label {
    color: var(--fg-muted);
  }

  .value {
    color: var(--fg);
  }

  .links a,
  .map a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease;
    overflow-wrap: anywhere;
  }

  .links a:hover,
  .map a:hover {
    border-color: var(--accent);
  }

  .social-icons {
    display: flex;
    gap: 0.35rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .social-icons a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 4px;
    color: var(--fg-muted);
    transition: color 0.15s ease, background 0.15s ease;
  }

  .social-icons a:hover {
    color: var(--accent);
    background: var(--bg-raised);
  }

  .where {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--fg-faint);
  }

  @media (max-width: 40rem) {
    .cols {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>

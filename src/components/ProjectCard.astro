---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const n = String(index + 1).padStart(2, '0');
---

<article class="card" data-tone={project.tone}>
  <div class="top">
    <span class="num">{n}</span>
    <h3>{project.title}</h3>
    <p class="kicker">{project.kicker}</p>
  </div>

  <p class="blurb">{project.blurb}</p>

  <ul class="tags">
    {project.tags.map((t) => <li>{t}</li>)}
  </ul>

  <div class="links">
    {
      project.links.map((l) => (
        <a href={l.href} rel="noopener">
          {l.label}
          <span aria-hidden="true">→</span>
        </a>
      ))
    }
  </div>
</article>

<style>
  .card {
    --from: var(--card-1-from);
    --to: var(--card-1-to);

    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: 12px;
    /* diagonal blue gradient, the light corner reads as where the light is */
    background: linear-gradient(150deg, var(--from) 0%, var(--to) 78%);
    color: #fff;
    border: 1px solid var(--silver-line);
    box-shadow: 0 18px 40px -24px rgba(0, 0, 0, 0.9);
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  /* silver sheen across the top-left corner */
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      120% 80% at 0% 0%,
      rgba(255, 255, 255, 0.16) 0%,
      rgba(255, 255, 255, 0.04) 38%,
      transparent 70%
    );
    pointer-events: none;
  }

  /* bright silver rule along the top edge */
  .card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--silver) 20%,
      var(--silver) 60%,
      transparent
    );
    opacity: 0.8;
    transition: opacity 0.18s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: rgba(218, 224, 232, 0.55);
    box-shadow: 0 26px 50px -22px rgba(0, 0, 0, 0.95);
  }

  .card:hover::before {
    opacity: 1;
  }

  .card[data-tone='c1'] {
    --from: var(--card-1-from);
    --to: var(--card-1-to);
  }
  .card[data-tone='c2'] {
    --from: var(--card-2-from);
    --to: var(--card-2-to);
  }
  .card[data-tone='c3'] {
    --from: var(--card-3-from);
    --to: var(--card-3-to);
  }
  .card[data-tone='c4'] {
    --from: var(--card-4-from);
    --to: var(--card-4-to);
  }

  .top {
    display: grid;
    gap: 0.35rem;
  }

  .num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--silver-dim);
  }

  h3 {
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    letter-spacing: -0.02em;
  }

  .kicker {
    font-size: 0.95rem;
    color: var(--silver);
  }

  .blurb {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    margin-top: auto;
    padding: 0;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--silver-line);
    color: var(--silver);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding-top: 0.5rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: inherit;
    text-decoration: none;
    color: var(--silver);
    border-bottom: 1px solid var(--silver-line);
    padding-bottom: 2px;
    transition: border-color 0.15s ease, gap 0.15s ease;
  }

  .links a:hover {
    color: #fff;
    border-color: var(--silver);
    gap: 0.65rem;
  }
</style>

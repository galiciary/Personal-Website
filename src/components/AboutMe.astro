---
// grouped the way the resume groups them
const skills = [
  {
    group: 'Languages',
    items: ['Python', 'Java', 'C', 'TypeScript', 'SQL', 'R', 'x86-64 Assembly'],
  },
  {
    group: 'Frameworks',
    items: ['React', 'Astro', 'Node.js', 'Express', 'Streamlit', 'pandas', 'NumPy'],
  },
  { group: 'Data', items: ['MySQL', 'MongoDB', 'Supabase'] },
  { group: 'Tools', items: ['Git'] },
];
---

<dl class="skills">
  {
    skills.map((s) => (
      <div class="row">
        <dt>{s.group}</dt>
        <dd>
          {s.items.map((item) => (
            <span class="chip">{item}</span>
          ))}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .skills {
    margin: 1.5rem 0 0;
    max-width: 62rem;
  }

  .row {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.7rem 0;
  }

  .row + .row {
    border-top: 1px solid var(--line);
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* same shape as the tags on the project cards, so the page stays one system */
  .chip {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--bg-raised);
    font-size: 0.8125rem;
    color: var(--fg);
    white-space: nowrap;
  }

  @media (max-width: 34rem) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }
  }
</style>

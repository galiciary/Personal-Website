---
// grouped the way the resume groups them
const skills = [
  { group: 'Languages', items: 'Python, Java, C, TypeScript, SQL, R, x86-64 Assembly' },
  { group: 'Frameworks', items: 'React, Astro, Node.js, Express, Streamlit, pandas, NumPy' },
  { group: 'Data', items: 'MySQL, MongoDB, Supabase' },
  { group: 'Tools', items: 'Git' },
];
---

<dl class="skills">
  {
    skills.map((s) => (
      <div class="row">
        <dt>{s.group}</dt>
        <dd>{s.items}</dd>
      </div>
    ))
  }
</dl>

<style>
  .skills {
    margin: 1.75rem 0 0;
    max-width: 62rem;
  }

  .row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.55rem 0;
    border-top: 1px solid var(--line);
  }

  .row:last-child {
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  @media (max-width: 34rem) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>

---
import { timeline } from '../data/timeline';

const labels: Record<string, string> = {
  role: 'Role',
  project: 'Project',
  education: 'Education',
  work: 'Work',
  certification: 'Certification',
};
---

<ol class="timeline" data-timeline>
  {
    timeline.map((entry) => (
      <li class="entry reveal" data-kind={entry.kind}>
        <div class="card">
          <p class="meta">
            <span class="kind">{labels[entry.kind]}</span>
            <span class="date">{entry.date}</span>
          </p>

          <h3>{entry.title}</h3>
          {entry.subtitle && <p class="subtitle">{entry.subtitle}</p>}
          {entry.blurb && <p class="blurb">{entry.blurb}</p>}

          {entry.links && (
            <div class="links">
              {entry.links.map((l) => (
                <a href={l.href} rel="noopener" target="_blank">
                  {l.label}
                  <span aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    position: relative;
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    /* 0 to 1, written by the script as the section scrolls past */
    --progress: 0;
  }

  /* the spine, centred, drawn behind the markers */
  .timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: 0.6rem;
    bottom: 0.6rem;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--line-strong) 8%,
      var(--line-strong) 92%,
      transparent
    );
  }

  /* the lit part of the spine, growing downward as the section is scrolled */
  .timeline::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: 0.6rem;
    width: 2px;
    height: calc(var(--progress) * (100% - 1.2rem));
    background: linear-gradient(to bottom, var(--accent-dim), var(--accent));
    box-shadow: 0 0 8px var(--accent-wash);
  }

  .entry {
    position: relative;
    /* keeps the markers above the lit spine */
    z-index: 1;
    width: calc(50% - 1.75rem);
    padding-bottom: 1.75rem;
  }

  /* entries arrive from their own side of the spine rather than from below */
  :global(.has-reveal) .entry.reveal {
    transform: translateX(-28px);
  }

  :global(.has-reveal) .entry:nth-child(even).reveal {
    transform: translateX(28px);
  }

  :global(.has-reveal) .entry.reveal.is-visible {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.has-reveal) .entry.reveal,
    :global(.has-reveal) .entry:nth-child(even).reveal {
      transform: none;
    }

    .timeline::after {
      display: none;
    }
  }

  /* odd entries sit left of the spine, even ones right */
  .entry:nth-child(odd) {
    margin-right: calc(50% + 1.75rem);
  }

  .entry:nth-child(even) {
    margin-left: calc(50% + 1.75rem);
  }

  .entry:last-child {
    padding-bottom: 0;
  }

  /* marker sitting on the spine, on whichever side the card is not */
  .entry::before {
    content: '';
    position: absolute;
    top: 1.15rem;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--bg-raised);
    border: 2px solid var(--accent-dim);
    box-shadow: 0 0 0 4px var(--bg);
    transition: box-shadow 0.5s ease 0.15s, transform 0.5s ease 0.15s;
  }

  /* the marker lights up a beat after its card lands */
  :global(.has-reveal) .entry.reveal::before {
    transform: scale(0.6);
  }

  :global(.has-reveal) .entry.reveal.is-visible::before {
    transform: none;
    box-shadow: 0 0 0 4px var(--bg), 0 0 10px 2px var(--accent-wash);
  }

  .entry:nth-child(odd)::before {
    right: -2.175rem;
  }

  .entry:nth-child(even)::before {
    left: -2.175rem;
  }

  .entry[data-kind='role']::before,
  .entry[data-kind='work']::before {
    background: var(--accent);
    border-color: var(--accent);
  }

  .entry[data-kind='education']::before {
    background: var(--silver);
    border-color: var(--silver);
  }

  .entry[data-kind='certification']::before {
    background: var(--silver-dim);
    border-color: var(--silver);
  }

  .card {
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-raised);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .kind {
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid var(--line-strong);
    color: var(--fg-muted);
  }

  .date {
    color: var(--accent);
  }

  h3 {
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .subtitle {
    margin-top: 0.15rem;
    font-size: 0.875rem;
    color: var(--fg-faint);
  }

  .blurb {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--fg-muted);
    max-width: 62ch;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: 0.8rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease, gap 0.15s ease;
  }

  .links a:hover {
    border-color: var(--accent);
    gap: 0.55rem;
  }

  /* one column with the spine on the left once there is no room to alternate */
  @media (max-width: 52rem) {
    .timeline {
      padding-left: 1.75rem;
    }

    .timeline::before,
    .timeline::after {
      left: 0.4rem;
      transform: none;
    }

    /* one side only, so both columns of cards arrive from the same direction */
    :global(.has-reveal) .entry.reveal,
    :global(.has-reveal) .entry:nth-child(even).reveal {
      transform: translateX(-20px);
    }

    :global(.has-reveal) .entry.reveal.is-visible {
      transform: none;
    }

    .entry,
    .entry:nth-child(odd),
    .entry:nth-child(even) {
      width: auto;
      margin-left: 0;
      margin-right: 0;
      padding-bottom: 1.5rem;
    }

    .entry:nth-child(odd)::before,
    .entry:nth-child(even)::before {
      left: -1.55rem;
      right: auto;
    }
  }
</style>

<script>
  // drives the lit portion of the spine from the scroll position, so the line
  // fills as the reader moves down the section
  const list = document.querySelector<HTMLElement>('[data-timeline]');

  if (list && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;

    function update() {
      ticking = false;
      const rect = list!.getBoundingClientRect();
      // the line tracks a point around two thirds down the viewport
      const marker = window.innerHeight * 0.66;
      const p = (marker - rect.top) / rect.height;
      list!.style.setProperty('--progress', String(Math.min(1, Math.max(0, p))));
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }
</script>

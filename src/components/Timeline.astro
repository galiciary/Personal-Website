---
import { timeline } from '../data/timeline';

const labels: Record<string, string> = {
  role: 'Role',
  project: 'Project',
  education: 'Education',
  work: 'Work',
};
---

<ol class="timeline">
  {
    timeline.map((entry) => (
      <li class="entry" data-kind={entry.kind}>
        <div class="card">
          <p class="meta">
            <span class="kind">{labels[entry.kind]}</span>
            <span class="date">{entry.date}</span>
          </p>

          <h3>{entry.title}</h3>
          {entry.subtitle && <p class="subtitle">{entry.subtitle}</p>}
          {entry.blurb && <p class="blurb">{entry.blurb}</p>}

          {entry.links && (
            <div class="links">
              {entry.links.map((l) => (
                <a href={l.href} rel="noopener" target="_blank">
                  {l.label}
                  <span aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    position: relative;
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }

  /* the spine, centred, drawn behind the markers */
  .timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: 0.6rem;
    bottom: 0.6rem;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--line-strong) 8%,
      var(--line-strong) 92%,
      transparent
    );
  }

  .entry {
    position: relative;
    width: calc(50% - 1.75rem);
    padding-bottom: 1.75rem;
  }

  /* odd entries sit left of the spine, even ones right */
  .entry:nth-child(odd) {
    margin-right: calc(50% + 1.75rem);
  }

  .entry:nth-child(even) {
    margin-left: calc(50% + 1.75rem);
  }

  .entry:last-child {
    padding-bottom: 0;
  }

  /* marker sitting on the spine, on whichever side the card is not */
  .entry::before {
    content: '';
    position: absolute;
    top: 1.15rem;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--bg-raised);
    border: 2px solid var(--accent-dim);
    box-shadow: 0 0 0 4px var(--bg);
  }

  .entry:nth-child(odd)::before {
    right: -2.175rem;
  }

  .entry:nth-child(even)::before {
    left: -2.175rem;
  }

  .entry[data-kind='role']::before,
  .entry[data-kind='work']::before {
    background: var(--accent);
    border-color: var(--accent);
  }

  .entry[data-kind='education']::before {
    background: var(--silver);
    border-color: var(--silver);
  }

  .card {
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-raised);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .kind {
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid var(--line-strong);
    color: var(--fg-muted);
  }

  .date {
    color: var(--accent);
  }

  h3 {
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .subtitle {
    margin-top: 0.15rem;
    font-size: 0.875rem;
    color: var(--fg-faint);
  }

  .blurb {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--fg-muted);
    max-width: 62ch;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: 0.8rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease, gap 0.15s ease;
  }

  .links a:hover {
    border-color: var(--accent);
    gap: 0.55rem;
  }

  /* one column with the spine on the left once there is no room to alternate */
  @media (max-width: 52rem) {
    .timeline {
      padding-left: 1.75rem;
    }

    .timeline::before {
      left: 0.4rem;
      transform: none;
    }

    .entry,
    .entry:nth-child(odd),
    .entry:nth-child(even) {
      width: auto;
      margin-left: 0;
      margin-right: 0;
      padding-bottom: 1.5rem;
    }

    .entry:nth-child(odd)::before,
    .entry:nth-child(even)::before {
      left: -1.55rem;
      right: auto;
    }
  }
</style>

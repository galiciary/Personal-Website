---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede?: string;
}

const { id, eyebrow, title, lede } = Astro.props;
---

<section class="section" id={id}>
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="section-title">{title}</h2>
    {lede && <p class="section-lede">{lede}</p>}
    <slot />
  </div>
</section>

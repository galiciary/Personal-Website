---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede?: string;
  // alternate the background band so sections do not read as one flat wall
  tone?: 'base' | 'raised' | 'sunken' | 'light';
}

const { id, eyebrow, title, lede, tone = 'base' } = Astro.props;
---

<section class="section reveal" id={id} data-tone={tone}>
  <!-- decoration sits outside .wrap so it can use the full section width -->
  <slot name="decor" />

  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="section-title">{title}</h2>
    {lede && <p class="section-lede">{lede}</p>}
    <slot />
  </div>
</section>

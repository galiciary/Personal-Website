---
import { site, socials } from '../data/site';
import Icon from './Icon.astro';
import Backdrop from './Backdrop.astro';
---

<section class="hero">
  <Backdrop />
  <div class="wrap inner">
    <p class="kicker">{site.location}</p>

    <h1>{site.name}</h1>

    <p class="tagline">{site.tagline}</p>

    <p class="intro">{site.intro}</p>

    <div class="actions">
      <a class="btn btn-primary" href="#work">See the work</a>
      <a class="btn" href="#contact">Get in touch</a>
    </div>

    <ul class="socials">
      {
        socials.map((s) => (
          <li>
            <a href={s.href} rel="me noopener" aria-label={s.label} title={s.label}>
              <Icon name={s.icon} />
            </a>
          </li>
        ))
      }
      <li>
        <button
          type="button"
          data-copy={site.email}
          aria-label={`Copy email address, ${site.email}`}
          title="Copy email address"
        >
          <Icon name="mail" />
        </button>
      </li>
    </ul>
  </div>

  <div class="toast" data-copy-toast role="status" aria-live="polite"></div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 11vh, 6.5rem) clamp(2.5rem, 6vh, 4rem);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: 0.45;
    mask-image: linear-gradient(to bottom, #000 0%, transparent 78%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 78%);
    pointer-events: none;
  }

  .inner {
    position: relative;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: 1.25rem;
  }

  .kicker::before {
    content: '';
    display: inline-block;
    width: 1.75rem;
    height: 1px;
    background: var(--accent-dim);
    vertical-align: middle;
    margin-right: 0.75rem;
  }

  h1 {
    font-size: clamp(2.75rem, 9vw, 5.25rem);
    letter-spacing: -0.035em;
    margin-bottom: 0.75rem;
  }

  .tagline {
    font-size: clamp(1.05rem, 2.6vw, 1.4rem);
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 1.75rem;
  }

  .intro {
    max-width: 54ch;
    color: var(--fg-muted);
    font-size: 1.0625rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.15rem;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }

  .btn:hover {
    border-color: var(--accent-dim);
    background: var(--accent-wash);
    color: var(--fg);
  }

  .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .btn-primary:hover {
    background: var(--accent-dim);
    border-color: var(--accent-dim);
    color: var(--bg);
  }

  .socials {
    display: flex;
    gap: 0.35rem;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
  }

  .socials a,
  .socials button {
    display: grid;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    border-radius: 4px;
    color: var(--fg-muted);
    transition: color 0.15s ease, background 0.15s ease;
    /* button reset */
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }

  .socials a:hover,
  .socials button:hover {
    color: var(--accent);
    background: var(--bg-raised);
  }

    .email-line {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    padding: 0.4rem 0.7rem;
    background: none;
    border: 1px solid transparent;
    border-radius: 4px;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .email-line:hover {
    color: var(--fg);
    border-color: var(--line-strong);
  }

  .email-line .hint {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .email-line:hover .hint {
    color: var(--accent);
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: 2rem;
    z-index: 80;
    transform: translate(-50%, 0.5rem);
    padding: 0.6rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: var(--bg-raised);
    color: var(--fg);
    font-size: 0.875rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.45);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .toast[data-visible] {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>

<script>
  const toast = document.querySelector<HTMLElement>('[data-copy-toast]');
  let hideTimer: number | undefined;

  function announce(message: string) {
    if (!toast) return;
    toast.textContent = message;
    toast.setAttribute('data-visible', '');
    window.clearTimeout(hideTimer);
    hideTimer = window.setTimeout(() => toast.removeAttribute('data-visible'), 2000);
  }

  document.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement | null;
    const trigger = target?.closest<HTMLElement>('[data-copy]');
    const value = trigger?.dataset.copy;
    if (!value) return;

    try {
      await navigator.clipboard.writeText(value);
      announce('Email copied to clipboard');
    } catch {
      // clipboard API needs a secure context and can be blocked outright.
      announce(`Couldn't copy, the address is ${value}`);
    }
  });
</script>

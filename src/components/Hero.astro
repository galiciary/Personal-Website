---
import { site, socials } from '../data/site';
import Icon from './Icon.astro';
import Backdrop from './Backdrop.astro';
---

<section class="hero">
  <Backdrop />

  <div class="wrap inner">
    <div class="portrait">
      {
        site.portrait ? (
          <img src={site.portrait} alt={`Portrait of ${site.fullName}`} width="240" height="240" />
        ) : (
          <div class="portrait-placeholder">
            <span>photo</span>
          </div>
        )
      }
    </div>

    <h1>{site.name}</h1>

    <p class="tagline">{site.tagline}</p>

    <p class="intro">{site.intro}</p>

    <div class="actions">
      <a class="btn btn-primary" href="#work">View projects</a>
      <a class="btn" href={site.resume} target="_blank" rel="noopener">Résumé</a>
      <a class="btn" href="#contact">Get in touch</a>
    </div>

    <ul class="socials">
      {
        socials.map((s) => (
          <li>
            <a href={s.href} rel="me noopener" aria-label={s.label} title={s.label}>
              <Icon name={s.icon} />
            </a>
          </li>
        ))
      }
      <li>
        <a href={`mailto:${site.email}`} target="_blank" rel="noopener" aria-label="Email" title={site.email}>
          <Icon name="mail" />
        </a>
      </li>
    </ul>
  </div>

  <a class="scroll-cue" href="#work" aria-label="Scroll to work">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: clamp(5rem, 12vh, 8rem);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: 0.45;
    mask-image: linear-gradient(to bottom, #000 0%, transparent 78%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 78%);
    pointer-events: none;
  }

  .inner {
    position: relative;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  h1 {
    font-size: clamp(2.75rem, 7vw, 4.75rem);
    letter-spacing: -0.035em;
    margin-bottom: 0.75rem;
  }

  .tagline {
    font-size: clamp(1.05rem, 2.4vw, 1.35rem);
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .intro {
    max-width: 52ch;
    color: var(--fg-muted);
    font-size: 1.0625rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.15rem;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }

  .btn:hover {
    border-color: var(--accent-dim);
    background: var(--accent-wash);
    color: var(--fg);
  }

  .btn-primary {
    background: var(--blue-grad);
    border-color: var(--silver-line);
    color: #fff;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.18) inset;
  }

  .btn-primary:hover {
    background: var(--blue-grad-hover);
    border-color: rgba(218, 224, 232, 0.55);
    color: #fff;
  }

  .socials {
    display: flex;
    justify-content: center;
    gap: 0.35rem;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    border-radius: 4px;
    color: var(--fg-muted);
    transition: color 0.15s ease, background 0.15s ease;
  }

  .socials a:hover {
    color: var(--accent);
    background: var(--bg-raised);
  }

  /* small round avatar, silver rim to match the cards */
  .portrait {
    width: clamp(6rem, 11vw, 7.5rem);
    aspect-ratio: 1;
  }

  .portrait img,
  .portrait-placeholder {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 1px solid var(--silver-line);
    box-shadow: 0 14px 34px -18px rgba(0, 0, 0, 0.95);
  }

  .portrait img {
    object-fit: cover;
  }

  .portrait-placeholder {
    display: grid;
    place-content: center;
    background: linear-gradient(150deg, var(--card-1-from) 0%, var(--card-1-to) 78%);
    color: var(--silver-dim);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    transform: translateX(-50%);
    width: 1.5rem;
    height: 2.4rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    display: grid;
    justify-items: center;
    padding-top: 0.45rem;
  }

  .scroll-cue span {
    width: 3px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
    animation: cue 1.8s ease-in-out infinite;
  }

  @keyframes cue {
    0%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }
    50% {
      transform: translateY(9px);
      opacity: 0.3;
    }
  }

  @media (max-width: 60rem) {
    .scroll-cue {
      display: none;
    }
  }
</style>